#!/bin/sh
#|-*- mode:lisp -*-|#
#|
exec ros -Q -- $0 "$@"
|#
(progn ;;init forms
  (ros:ensure-asdf)
  #+quicklisp(ql:quickload '(:makima) :silent nil)
  )

(defpackage :ros.script.makima.3927534892
  (:use :cl))
(in-package :ros.script.makima.3927534892)

(defun main (&optional deamonless seed &rest argv)
  (declare (ignorable argv))
  (handler-case
      (progn 
        (when seed (makima.seeder:seed))
        (if deamonless
            (makima:main-deamonless #'makima.server:start)
            (makima:main #'makima.server:start)))
    (error (e)
      (format *standard-output* "~&Error: ~A~%" e)
      (uiop:quit -1))))
